{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "paths": {
      "@prisma/client": ["prisma/generated/prisma/client"]
    }
  },
  "include": [
    "src/**/*"
, "src/services/tryout.section.service.ts"  ],
  "exclude": ["node_modules", "dist"]
}
